# Plantilla del .env del servidor de herramientas.
#
# bootstrap-tools.sh crea /opt/cg-tools/.env a partir de esta plantilla la
# PRIMERA vez y genera los secretos marcados como __GENERATE__ con
# `openssl rand -hex`. Si el .env ya existe no lo toca (idempotencia).
# El .env real nunca va a git (.gitignore).

# Base de datos de SonarQube
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=__GENERATE__
# Reemplaza el admin/admin por defecto de SonarQube
SONAR_ADMIN_PASSWORD=__GENERATE__

# Nexus: contraseña del admin (reemplaza la inicial aleatoria de Nexus)
NEXUS_ADMIN_PASSWORD=__GENERATE__
# Usuario de Jenkins con permiso de push SOLO al repo circleguard
NEXUS_CI_USER=jenkins-ci
NEXUS_CI_PASSWORD=__GENERATE__
# Usuario de solo lectura para que los servidores de ambiente hagan docker pull
NEXUS_PULL_USER=deploy-pull
NEXUS_PULL_PASSWORD=__GENERATE__

# Memoria (ajustar al tamaño de la VM)
JENKINS_HEAP=1g
NEXUS_HEAP=1g

# Lo completa el script (GID del grupo docker del host)
DOCKER_GID=
