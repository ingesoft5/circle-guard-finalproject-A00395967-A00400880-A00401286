# Variables de docker-compose.dev.yml (middleware para desarrollo local, CG-22).
#
# Uso opcional: cp .env.example .env  (el .env real NUNCA va a git).
# Sin .env, el compose usa los valores de desarrollo por defecto, que son los que
# esperan los application.yml (admin / password / admin).
#
# Si cambias estos valores, los servicios que corres con Gradle también deben
# recibirlos, p. ej.:
#   SPRING_DATASOURCE_PASSWORD=... SPRING_NEO4J_AUTHENTICATION_PASSWORD=... ./gradlew :services:<servicio>:bootRun
# Los despliegues dev/stage/prod usan deploy/<ambiente>/.env.example, no este archivo.

POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-postgres-password
# Neo4j 5 exige 8+ caracteres.
NEO4J_PASSWORD=change-me-neo4j-password
LDAP_ADMIN_PASSWORD=change-me-ldap-admin-password
