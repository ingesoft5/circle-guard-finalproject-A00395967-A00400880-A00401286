# Plantilla del .env de prod. bootstrap-env.sh la copia como /opt/circleguard/prod/.env
# (solo si aún no existe) y reemplaza los secretos por valores aleatorios.
# El .env real NUNCA va a git. VERSION no va aquí: la exporta el pipeline.
#
# Las líneas comentadas son opcionales: si faltan, el compose usa su valor por
# defecto. Así este archivo no deja valores change-me-... en un servidor.

# --- Ambiente y registro (bootstrap-env.sh las reafirma en cada ejecución)
CG_ENV=prod
# Registro Docker de Nexus en cg-tools. El pipeline también lo exporta (CG_REGISTRY)
# y el valor exportado tiene prioridad sobre este.
REGISTRY=20.230.211.66:8082
WEB_PORT=80

# --- Secretos: bootstrap-env.sh genera cada uno con `openssl rand -hex 32`.
# Los valores de abajo solo sirven para probar en local.
POSTGRES_PASSWORD=change-me-postgres-password
# Neo4j exige 8+ caracteres. El usuario siempre es 'neo4j'.
NEO4J_PASSWORD=change-me-neo4j-password
# Admin de OpenLDAP: cn=admin,dc=circleguard,dc=edu.
LDAP_ADMIN_PASSWORD=change-me-ldap-admin-password
# Firmas HMAC-SHA256: mínimo 32 caracteres. Cada uno es el mismo en todos los
# servicios que lo usan (el compose lo reparte).
JWT_SECRET=change-me-jwt-secret-use-openssl-rand-hex-32
QR_SECRET=change-me-qr-secret-use-openssl-rand-hex-32
# Bóveda de identidades (identity). ¡No cambiar después de tener datos!
# Con otra clave o salt los datos cifrados existentes no se pueden leer.
VAULT_SECRET=change-me-vault-secret-use-openssl-rand-hex-32
# change-me: VAULT_SALT debe ser HEXADECIMAL (openssl rand -hex 32).
VAULT_SALT=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Secretos opcionales (bootstrap-env.sh no los genera)
# Sin LDAP_CONFIG_PASSWORD se usa LDAP_ADMIN_PASSWORD (solo cuenta al crear el volumen).
# LDAP_CONFIG_PASSWORD=
# Sin VAULT_HASH_SALT se usa VAULT_SALT. No agregarla en un ambiente con datos:
# cambia el hash de las identidades y ya no se encuentran.
# VAULT_HASH_SALT=

# --- Capacidad (valores por defecto pensados para una VM de 8 GB; ver deploy/README.md)
# JAVA_MEM_LIMIT=512m
# POSTGRES_MEM_LIMIT=384m
# NEO4J_MEM_LIMIT=1g
# NEO4J_HEAP_MAX=384m
# NEO4J_PAGECACHE=128m
# KAFKA_MEM_LIMIT=768m

# --- Otros valores opcionales
# POSTGRES_USER=circleguard

# --- Integraciones externas de notification (opcionales; vacías = modo mock)
# SMTP_HOST=
# SMTP_PORT=25
# GOTIFY_URL=
# GOTIFY_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
